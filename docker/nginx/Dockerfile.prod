# Contexto de build = raiz do repositório (ver .github/workflows/deploy.yml).
FROM nginx:stable-alpine

RUN rm /etc/nginx/conf.d/default.conf

COPY docker/nginx/prod.conf /etc/nginx/conf.d/default.conf

# public/ vai assado na imagem em vez de vir por volume compartilhado: um
# volume nomeado só é populado na criação, então o nginx continuaria servindo
# o public/ do primeiro deploy para sempre.
COPY public/ /var/www/html/public/

EXPOSE 80 443
