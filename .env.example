# APP
APP_NAME=Pandy Post
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:9000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
FRONTEND_URL=http://localhost:5173
CONTAINER_NAME=pandypost-php

# AUTH
BCRYPT_ROUNDS=12
TOKEN_SANCTUM_EXPIRATION=480
AUTH_VERIFICATION_TIMEOUT=1440
AUTH_TOKEN_EXPIRATION_DAYS=30
INVITE_EXPIRATION_DAYS=3

# DATABASE
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=pandypost
DB_USERNAME=pandypost
DB_PASSWORD=pandypost

# REDIS
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# CACHE / QUEUE / SESSION
CACHE_STORE=redis
CACHE_PREFIX=pandypost_cache_
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# HORIZON
HORIZON_NAME=PandyPost
HORIZON_PATH=horizon
HORIZON_DOMAIN=

# LOG
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MAIL
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
FILESYSTEM_DISK=s3

# SOCIAL (Instagram / Meta)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# SOCIAL (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# SOCIAL (TikTok)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# CLOUDFLARE (SSL Origin Certificate)
CF_API_TOKEN=
CF_HOSTNAMES=pandy.pro,*.pandy.pro

# DEPLOY (GHCR)
IMAGE_PREFIX=ghcr.io/pandyia
IMAGE_TAG=latest
