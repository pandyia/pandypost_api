# APP
APP_NAME="Pandy Post"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:9000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
FRONTEND_URL=http://localhost:5173

# CORS — origens do browser autorizadas a chamar /api/*, separadas por vírgula.
# Sem valor, cai em FRONTEND_URL. Só afeta browser: webhook do Stripe e
# clientes não-browser ignoram CORS.
CORS_ALLOWED_ORIGINS=

# AUTH
TOKEN_SANCTUM_EXPIRATION=480
AUTH_VERIFICATION_TIMEOUT=1440

# DATABASE — dev usa o Postgres do docker-compose.yml
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=pandypost
DB_USERNAME=pandypost
DB_PASSWORD=pandypost
# Produção (Supabase): use o POOLER. A conexão direta db.<ref>.supabase.co é
# IPv6-only e as bridges do Docker são IPv4. Porta 5432 = session mode; a 6543
# não suporta prepared statements e exige DB_EMULATE_PREPARES=true.
# DB_HOST=aws-0-<regiao>.pooler.supabase.com
# DB_DATABASE=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_SSLMODE=require

# REDIS — instância de filas/Horizon e instância de cache/sessão
# Em produção as duas exigem senha; o deploy aborta se REDIS_PASSWORD ficar
# vazia ou como "null".
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_CACHE_HOST=redis-cache

# CACHE / QUEUE / SESSION
CACHE_STORE=redis
CACHE_PREFIX=pandypost_cache_
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

# OCTANE
OCTANE_SERVER=swoole
OCTANE_HTTPS=false

# REVERB
REVERB_APP_ID=100000
REVERB_APP_KEY=pandypost-reverb-key
REVERB_APP_SECRET=pandypost-reverb-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
SESSION_DRIVER=redis
# Sessão na instância de cache: na de filas ocuparia o orçamento do noeviction.
SESSION_CONNECTION=cache

# LOG — em produção use LOG_STACK=stderr (o Docker captura e rotaciona) e
# LOG_LEVEL=warning. LOG_DEPRECATIONS_CHANNEL=null manda deprecations para o
# stack; remover a linha faria o default 'null' (a string) descartá-las.
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# MAIL — Resend pela API HTTP, não por SMTP. O domínio do MAIL_FROM_ADDRESS
# precisa estar verificado no Resend (DNS), senão a API recusa o envio.
# Em local, MAIL_MAILER=log escreve o e-mail no log e não gasta cota.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=nao-responda@pandy.pro
MAIL_FROM_NAME="${APP_NAME}"

# OBJECT STORAGE — dev usa o MinIO do docker-compose.yml; produção, Backblaze B2.
# São dois hosts para o mesmo storage: AWS_ENDPOINT é por onde o PHP fala com o
# MinIO (rede do Docker), AWS_TEMPORARY_URL é o host que entra nas presigned
# URLs entregues ao browser, servido pelo proxy do nginx em localhost:9002. A
# presigned URL assina o header Host, e o proxy restaura o de AWS_ENDPOINT antes
# de repassar — por isso os dois valores. MinIO só atende path-style.
# Bucket criado sozinho pelo serviço minio-init; console em http://localhost:9001
# (login pandypost / pandypost).
AWS_ACCESS_KEY_ID=pandypost
AWS_SECRET_ACCESS_KEY=pandypost
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=pandypost
AWS_ENDPOINT=http://minio:9000
AWS_TEMPORARY_URL=http://localhost:9002
AWS_USE_PATH_STYLE_ENDPOINT=true
FILESYSTEM_DISK=s3
# Produção (Backblaze B2, API S3-compatível): deixe AWS_TEMPORARY_URL vazio para
# as presigned URLs saírem com o próprio endpoint. A região precisa casar com o
# endpoint e o CORS vai no bucket, senão o PUT do browser é bloqueado antes de
# chegar no storage.
# AWS_DEFAULT_REGION=us-west-004
# AWS_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# AWS_TEMPORARY_URL=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# STRIPE / CASHIER — STRIPE_ENABLED=false usa ids locais (dev_...) sem chamar
# o gateway. Em produção defina true.
STRIPE_ENABLED=false
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=brl

# SOCIAL
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# DEPLOY (GHCR) — fallback para rodar docker compose na mão no servidor
IMAGE_PREFIX=ghcr.io/pandyia
IMAGE_TAG=latest
