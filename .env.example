# APP
APP_NAME="Pandy Post"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:9000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
FRONTEND_URL=http://localhost:5173
CONTAINER_NAME=pandypost-php

# AUTH
BCRYPT_ROUNDS=12
TOKEN_SANCTUM_EXPIRATION=480
AUTH_VERIFICATION_TIMEOUT=1440
AUTH_TOKEN_EXPIRATION_DAYS=30
INVITE_EXPIRATION_DAYS=3

# DATABASE
# Dev: Postgres do docker-compose.yml.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=pandypost
DB_USERNAME=pandypost
DB_PASSWORD=pandypost
DB_SSLMODE=prefer
DB_EMULATE_PREPARES=false
#
# Produção (Supabase, só o Postgres):
#   Use o POOLER, não a conexão direta. `db.<ref>.supabase.co` resolve apenas
#   para IPv6, e as bridges do Docker são IPv4-only por padrão — os containers
#   não conseguiriam alcançar. O pooler responde em IPv4.
#
#   Porta 5432 = session mode: suporta prepared statements, que é o que o
#   PDO_PGSQL usa. Porta 6543 = transaction mode: NÃO suporta, e exige
#   DB_EMULATE_PREPARES=true. Comece na 5432; só migre para a 6543 se bater
#   no limite de conexões do plano free.
#
#   O pico de conexões desta stack é ~20: 8 do PHP-FPM (pm.max_children),
#   10 dos workers do Horizon e ~2 do scheduler.
#
# DB_HOST=aws-0-<regiao>.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<senha do banco>
# DB_SSLMODE=require

# REDIS
# Instância de filas/Horizon: noeviction + AOF (ver docker/redis/redis.conf).
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Instância de cache/sessão: allkeys-lru, sem persistência. Em produção aponta
# para o serviço `redis-cache`. Deixe vazio/comentado em dev para cair de volta
# em REDIS_HOST e rodar com uma instância só.
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_DB=1

# CACHE / QUEUE / SESSION
CACHE_STORE=redis
CACHE_PREFIX=pandypost_cache_
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
SESSION_DRIVER=redis
# Sessão vai para a instância de cache: se ficasse na de filas, ocuparia o
# orçamento do noeviction e poderia travar o enqueue de posts agendados.
SESSION_CONNECTION=cache
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Precisa ser MAIOR que o maior timeout de supervisor em config/horizon.php
# (300s no youtube/tiktok). Se for menor, a fila devolve o job para outro
# worker enquanto o primeiro ainda está publicando -> post duplicado.
REDIS_QUEUE_RETRY_AFTER=360

# HORIZON
HORIZON_NAME=PandyPost
HORIZON_PATH=horizon
HORIZON_DOMAIN=

# Teto de processos por fila em produção. Somados, cabem no limite de 2304M do
# container horizon — recalcule antes de aumentar (ver comentário em
# config/horizon.php).
HORIZON_MAX_DEFAULT=3
HORIZON_MAX_INSTAGRAM=3
HORIZON_MAX_YOUTUBE=2
HORIZON_MAX_TIKTOK=2

# LOG
# Em produção use LOG_STACK=stderr: o Docker captura e rotaciona via
# daemon.json, sem depender do logrotate interno do container.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MAIL
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# OBJECT STORAGE (Backblaze B2, via API S3-compatível)
#   AWS_DEFAULT_REGION precisa ser a mesma região do endpoint (a conta B2 fica
#   presa a uma região só). Ex.: us-west-004, eu-central-003.
#   AWS_ACCESS_KEY_ID / SECRET = keyID e applicationKey de uma Application Key
#   do B2 restrita ao bucket.
#   O B2 aceita virtual-hosted style, então PATH_STYLE fica false.
#   AWS_URL fica vazio de propósito: os downloads usam presigned GET.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-004
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=https://s3.us-west-004.backblazeb2.com
AWS_USE_PATH_STYLE_ENDPOINT=false
FILESYSTEM_DISK=s3

# S3 Presigned URLs
# O upload é um PUT de parte única direto do browser, então o teto é 5 GiB —
# limite do PutObject no B2. Passar disso exigiria multipart upload.
# Lembre de configurar as regras de CORS do bucket no B2, senão o PUT do
# browser é bloqueado antes de chegar no storage.
S3_PRESIGNED_PUT_TTL=86400
S3_PRESIGNED_GET_TTL=1800
S3_MAX_UPLOAD_SIZE=5368709120

# STRIPE / CASHIER (Billing / Financeiro)
# STRIPE_ENABLED=false desativa as chamadas do catálogo (Admin) ao gateway
# (ids locais dev_...), útil em dev/testes. Em produção defina true.
STRIPE_ENABLED=false
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
CASHIER_CURRENCY=brl
CASHIER_CURRENCY_LOCALE=pt_BR

# SOCIAL (Instagram / Meta)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# SOCIAL (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# SOCIAL (TikTok)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# CLOUDFLARE (SSL Origin Certificate)
CF_API_TOKEN=
CF_HOSTNAMES=pandy.pro,*.pandy.pro

# DEPLOY (GHCR)
IMAGE_PREFIX=ghcr.io/pandyia
IMAGE_TAG=latest
