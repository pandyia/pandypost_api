            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"content_type\": \"video/mp4\",\n  \"directory\": \"videos\"\n}" },
            "url": { "raw": "{{base_url}}/scheduled-posts/upload-url", "host": ["{{base_url}}"], "path": ["scheduled-posts", "upload-url"] },
            "description": "Gera URL pré-assinada do S3 para upload direto.\ncontent_type: video/mp4, video/quicktime, image/jpeg, image/png, image/jpg.\ndirectory: videos, thumbnails, images."
          }
        },
        {
          "name": "Create Scheduled Post",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"media_storage_path\": \"workspaces/{{workspace_uuid}}/videos/abc123.mp4\",\n  \"thumbnail_storage_path\": \"workspaces/{{workspace_uuid}}/thumbnails/thumb.jpg\",\n  \"social_account_uuids\": [\"{{social_account_uuid}}\"],\n  \"title\": \"Meu vídeo incrível\",\n  \"caption\": \"Confira esse conteúdo novo! #pandy\",\n  \"scheduled_at\": \"2026-07-15T14:00:00Z\",\n  \"is_short\": false,\n  \"youtube_privacy_status\": \"public\",\n  \"youtube_category_id\": \"22\",\n  \"youtube_tags\": [\"tutorial\", \"pandy\"],\n  \"youtube_made_for_kids\": false,\n  \"pipeline_card_uuid\": null\n}"
            },
            "url": { "raw": "{{base_url}}/scheduled-posts", "host": ["{{base_url}}"], "path": ["scheduled-posts"] },
            "description": "Cria um post agendado. O vídeo já deve ter sido enviado ao S3 via upload-url.\nscheduled_at deve ser pelo menos 5 min no futuro (opcional; se nulo, publica imediatamente)."
          }
        }
      ]
    },
